        </mxCell>

        <!-- Actions to Event Bus -->
        <mxCell id="e_act_publish" value="4. publish(APPOINTMENT_SCHEDULED)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C2410C;strokeWidth=1.8;endArrow=block;" edge="1" parent="1" source="act_appointment" target="ob_subject">
          <mxGeometry relative="1" as="geometry">
