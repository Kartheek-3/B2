        <!-- External Box 1: Mock Video Provider -->
        <mxCell id="ext_video_adaptee" value="&lt;b&gt;&amp;lt;&amp;lt;Adaptee&amp;gt;&amp;gt; LocalDemonstrationVideoProvider&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;[EXPLICIT LOCAL DEMONSTRATION MOCK]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:11px;padding:6px;&quot;&gt;• Proprietary meeting engine API: initiateMeetingSession(), querySession(), mintJoinToken()&lt;br&gt;• Generates signed mock JWT participant tokens &amp;amp; demonstration room URLs&lt;br&gt;• &lt;b&gt;Academic Disclosure&lt;/b&gt;: Simulates video infrastructure offline with zero external credential dependencies;&lt;br&gt;  does NOT connect to live WebRTC media servers or external paid APIs (Zoom / Twilio Video / Daily.co).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="1080" width="700" height="130" as="geometry" />
        </mxCell>

        <!-- External Box 2: External Scheduler Trigger -->
        <mxCell id="ext_scheduler" value="&lt;b&gt;External Scheduler Trigger&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;&lt;b&gt;[RECURRING CRON / HTTP TRIGGER]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:11px;padding:6px;&quot;&gt;• Linux Cron / Vercel Cron / AWS EventBridge / CI Test Runner&lt;br&gt;• Invokes &lt;b&gt;POST /api/reminders/process&lt;/b&gt; with &lt;i&gt;x-scheduled-token&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Operational Disclosure&lt;/b&gt;: Next.js serverless runtimes do NOT run perpetual daemon threads in process memory;&lt;br&gt;  the processing engine executes strictly upon external on-demand HTTP invocation.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="820" y="1080" width="700" height="130" as="geometry" />
        </mxCell>

        <!-- External Box 3: Notification Sinks -->
        <mxCell id="ext_telecom" value="&lt;b&gt;External Telephony &amp;amp; Notification Sink&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;&lt;b&gt;[AT-LEAST-ONCE DELIVERY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:11px;padding:6px;&quot;&gt;• Twilio SMS Gateway / Local Logger Dispatch Sink&lt;br&gt;• External communication channels do not participate in 2-phase database transactions&lt;br&gt;• Guarantees &lt;b&gt;At-Least-Once Delivery&lt;/b&gt; with application idempotency keys preventing duplicates.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1560" y="1080" width="710" height="130" as="geometry" />
        </mxCell>


        <!-- LEGEND & METADATA BOX -->
        <mxCell id="box_legend" value="&lt;b&gt;ARCHITECTURE LEGEND &amp;amp; AUDIT METADATA&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:11px;padding:4px;&quot;&gt;&lt;span style=&quot;color:#2563EB;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Blue&lt;/b&gt;: CH01 Adapter Pattern (Structural - Implemented)&lt;br&gt;&lt;span style=&quot;color:#059669;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Green&lt;/b&gt;: CH02 Strategy Pattern (Behavioral - Implemented)&lt;br&gt;&lt;span style=&quot;color:#C2410C;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Orange&lt;/b&gt;: CH03 Observer Pattern (Behavioral - Implemented)&lt;br&gt;&lt;span style=&quot;color:#7E22CE;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Purple&lt;/b&gt;: Infrastructure &amp;amp; Appwrite Services&lt;br&gt;&lt;span style=&quot;color:#64748B;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Gray&lt;/b&gt;: Existing Application Components&lt;br&gt;───► Solid Arrow: Synchronous Method Call / Invocation&lt;br&gt;- - -► Dashed Arrow: Interface Realization / Event Dispatch&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="1230" width="450" height="75" as="geometry" />
        </mxCell>


        <!-- CONNECTORS / EDGES -->
        <!-- UI to Server Actions -->
        <mxCell id="e_ui_act" value="submit form" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ui_appointment_form" target="act_appointment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Actions to Strategy Context -->
        <mxCell id="e_act_strategy" value="1. validateSlot()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.8;endArrow=block;" edge="1" parent="1" source="act_appointment" target="st_context">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1020" y="240" />
              <mxPoint x="1020" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Context to Strategy Interface -->
        <mxCell id="e_ctx_interface" value="delegates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="st_context" target="st_interface">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Concrete Strategies implement Interface -->
        <mxCell id="e_st1_impl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.2;dashed=1;endArrow=block;" edge="1" parent="1" source="st_concrete1" target="st_interface">
          <mxGeometry relative="1" as="geometry" />
