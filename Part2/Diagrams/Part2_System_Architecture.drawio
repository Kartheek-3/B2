              <mxPoint x="490" y="1040" />
              <mxPoint x="490" y="760" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Reminders API calls Engine -->
        <mxCell id="e_api_engine" value="processDueReminders()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C2410C;strokeWidth=1.8;endArrow=block;" edge="1" parent="1" source="ui_reminders_api" target="ob_engine">
          <mxGeometry relative="1" as="geometry">
