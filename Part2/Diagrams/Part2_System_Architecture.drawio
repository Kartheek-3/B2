        <!-- Engine to Telecom Sink -->
        <mxCell id="e_engine_telecom" value="sendSMS()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ob_engine" target="ext_telecom">
          <mxGeometry relative="1" as="geometry">
