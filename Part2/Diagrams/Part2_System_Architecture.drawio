        <mxCell id="e_st2_impl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.2;dashed=1;endArrow=block;" edge="1" parent="1" source="st_concrete2" target="st_interface">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_st3_impl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.2;dashed=1;endArrow=block;" edge="1" parent="1" source="st_concrete3" target="st_interface">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Actions to Adapter Factory / Target -->
        <mxCell id="e_act_adapter" value="2. createRoom() if isTeleconsult" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.8;endArrow=block;" edge="1" parent="1" source="act_appointment" target="ad_target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Adapter implements Target Interface -->
        <mxCell id="e_ad_impl" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.5;dashed=1;endArrow=block;" edge="1" parent="1" source="ad_adapter" target="ad_target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Factory supplies Adapter -->
        <mxCell id="e_fact_supplies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.2;dashed=1;endArrow=block;" edge="1" parent="1" source="ad_factory" target="ad_adapter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Adapter delegates to Adaptee -->
        <mxCell id="e_ad_adaptee" value="adapts / calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ad_adapter" target="ext_video_adaptee">
          <mxGeometry relative="1" as="geometry">
