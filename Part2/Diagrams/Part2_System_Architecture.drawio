        <!-- Engine to Store -->
        <mxCell id="e_engine_store" value="findDue &amp;amp; update status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7E22CE;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ob_engine" target="inf_reminder_store">
          <mxGeometry relative="1" as="geometry">
