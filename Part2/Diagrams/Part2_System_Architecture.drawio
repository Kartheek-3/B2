              <mxPoint x="1030" y="320" />
              <mxPoint x="1030" y="740" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Subject notifies Observers -->
        <mxCell id="e_bus_obs1" value="notify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C2410C;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ob_subject" target="ob_obs1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_bus_obs2" value="notify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C2410C;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ob_subject" target="ob_obs2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Observer to Store -->
        <mxCell id="e_obs1_store" value="save reminders" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7E22CE;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ob_obs1" target="inf_reminder_store">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1500" y="760" />
              <mxPoint x="1820" y="760" />
              <mxPoint x="1820" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- External Scheduler calls Reminders API -->
        <mxCell id="e_cron_api" value="POST /api/reminders/process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EF4444;strokeWidth=1.8;endArrow=block;" edge="1" parent="1" source="ext_scheduler" target="ui_reminders_api">
          <mxGeometry relative="1" as="geometry">
