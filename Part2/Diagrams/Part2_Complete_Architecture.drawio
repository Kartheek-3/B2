        <!-- External Box 1: Mock Video Provider -->
        <mxCell id="ext_video_adaptee" value="&lt;b&gt;&amp;lt;&amp;lt;Adaptee&amp;gt;&amp;gt; LocalDemonstrationVideoProvider&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;[EXPLICIT LOCAL DEMONSTRATION MOCK]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:11px;padding:6px;&quot;&gt;• Proprietary meeting engine API: initiateMeetingSession(), querySession(), mintJoinToken()&lt;br&gt;• Generates signed mock JWT participant tokens &amp;amp; demonstration room URLs&lt;br&gt;• &lt;b&gt;Academic Disclosure&lt;/b&gt;: Simulates video infrastructure offline with zero external credential dependencies;&lt;br&gt;  does NOT connect to live WebRTC media servers or external paid APIs (Zoom / Twilio Video / Daily.co).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="1080" width="700" height="130" as="geometry" />
        </mxCell>

        <!-- External Box 2: External Scheduler Trigger -->
        <mxCell id="ext_scheduler" value="&lt;b&gt;External Scheduler Trigger&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;&lt;b&gt;[RECURRING CRON / HTTP TRIGGER]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:11px;padding:6px;&quot;&gt;• Linux Cron / Vercel Cron / AWS EventBridge / CI Test Runner&lt;br&gt;• Invokes &lt;b&gt;POST /api/reminders/process&lt;/b&gt; with &lt;i&gt;x-scheduled-token&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Operational Disclosure&lt;/b&gt;: Next.js serverless runtimes do NOT run perpetual daemon threads in process memory;&lt;br&gt;  the processing engine executes strictly upon external on-demand HTTP invocation.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="820" y="1080" width="700" height="130" as="geometry" />
        </mxCell>

        <!-- External Box 3: Notification Sinks -->
        <mxCell id="ext_telecom" value="&lt;b&gt;External Telephony &amp;amp; Notification Sink&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;&lt;b&gt;[AT-LEAST-ONCE DELIVERY]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:11px;padding:6px;&quot;&gt;• Twilio SMS Gateway / Local Logger Dispatch Sink&lt;br&gt;• External communication channels do not participate in 2-phase database transactions&lt;br&gt;• Guarantees &lt;b&gt;At-Least-Once Delivery&lt;/b&gt; with application idempotency keys preventing duplicates.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1560" y="1080" width="710" height="130" as="geometry" />
        </mxCell>


        <!-- LEGEND & METADATA BOX -->
        <mxCell id="box_legend" value="&lt;b&gt;ARCHITECTURE LEGEND &amp;amp; AUDIT METADATA&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:11px;padding:4px;&quot;&gt;&lt;span style=&quot;color:#2563EB;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Blue&lt;/b&gt;: CH01 Adapter Pattern (Structural - Implemented)&lt;br&gt;&lt;span style=&quot;color:#059669;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Green&lt;/b&gt;: CH02 Strategy Pattern (Behavioral - Implemented)&lt;br&gt;&lt;span style=&quot;color:#C2410C;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Orange&lt;/b&gt;: CH03 Observer Pattern (Behavioral - Implemented)&lt;br&gt;&lt;span style=&quot;color:#7E22CE;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Purple&lt;/b&gt;: Infrastructure &amp;amp; Appwrite Services&lt;br&gt;&lt;span style=&quot;color:#64748B;&quot;&gt;■&lt;/span&gt; &lt;b&gt;Gray&lt;/b&gt;: Existing Application Components&lt;br&gt;───► Solid Arrow: Synchronous Method Call / Invocation&lt;br&gt;- - -► Dashed Arrow: Interface Realization / Event Dispatch&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="1230" width="450" height="75" as="geometry" />
        </mxCell>


        <!-- CONNECTORS / EDGES -->
        <!-- UI to Server Actions -->
        <mxCell id="e_ui_act" value="submit form" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#334155;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ui_appointment_form" target="act_appointment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Actions to Strategy Context -->
        <mxCell id="e_act_strategy" value="1. validateSlot()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.8;endArrow=block;" edge="1" parent="1" source="act_appointment" target="st_context">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1020" y="240" />
              <mxPoint x="1020" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Context to Strategy Interface -->
        <mxCell id="e_ctx_interface" value="delegates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="st_context" target="st_interface">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Concrete Strategies implement Interface -->
        <mxCell id="e_st1_impl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.2;dashed=1;endArrow=block;" edge="1" parent="1" source="st_concrete1" target="st_interface">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_st2_impl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.2;dashed=1;endArrow=block;" edge="1" parent="1" source="st_concrete2" target="st_interface">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_st3_impl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.2;dashed=1;endArrow=block;" edge="1" parent="1" source="st_concrete3" target="st_interface">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Actions to Adapter Factory / Target -->
        <mxCell id="e_act_adapter" value="2. createRoom() if isTeleconsult" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.8;endArrow=block;" edge="1" parent="1" source="act_appointment" target="ad_target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Adapter implements Target Interface -->
        <mxCell id="e_ad_impl" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.5;dashed=1;endArrow=block;" edge="1" parent="1" source="ad_adapter" target="ad_target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Factory supplies Adapter -->
        <mxCell id="e_fact_supplies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.2;dashed=1;endArrow=block;" edge="1" parent="1" source="ad_factory" target="ad_adapter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Adapter delegates to Adaptee -->
        <mxCell id="e_ad_adaptee" value="adapts / calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ad_adapter" target="ext_video_adaptee">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1460" y="360" />
              <mxPoint x="430" y="360" />
              <mxPoint x="430" y="1080" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Video API Route to Target -->
        <mxCell id="e_api_video_ad" value="mint access" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ui_video_api" target="ad_target">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="640" />
              <mxPoint x="510" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Actions to Appwrite Databases -->
        <mxCell id="e_act_db" value="3. createDocument()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7E22CE;strokeWidth=1.8;endArrow=block;" edge="1" parent="1" source="act_appointment" target="inf_databases">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1040" y="200" />
              <mxPoint x="1040" y="80" />
              <mxPoint x="1950" y="80" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Actions to Event Bus -->
        <mxCell id="e_act_publish" value="4. publish(APPOINTMENT_SCHEDULED)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C2410C;strokeWidth=1.8;endArrow=block;" edge="1" parent="1" source="act_appointment" target="ob_subject">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="320" />
              <mxPoint x="1030" y="740" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Subject notifies Observers -->
        <mxCell id="e_bus_obs1" value="notify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C2410C;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ob_subject" target="ob_obs1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_bus_obs2" value="notify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C2410C;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ob_subject" target="ob_obs2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Observer to Store -->
        <mxCell id="e_obs1_store" value="save reminders" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7E22CE;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ob_obs1" target="inf_reminder_store">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1500" y="760" />
              <mxPoint x="1820" y="760" />
              <mxPoint x="1820" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- External Scheduler calls Reminders API -->
        <mxCell id="e_cron_api" value="POST /api/reminders/process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EF4444;strokeWidth=1.8;endArrow=block;" edge="1" parent="1" source="ext_scheduler" target="ui_reminders_api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1170" y="1040" />
              <mxPoint x="490" y="1040" />
              <mxPoint x="490" y="760" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Reminders API calls Engine -->
        <mxCell id="e_api_engine" value="processDueReminders()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C2410C;strokeWidth=1.8;endArrow=block;" edge="1" parent="1" source="ui_reminders_api" target="ob_engine">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="500" y="780" />
              <mxPoint x="500" y="900" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Engine to Store -->
        <mxCell id="e_engine_store" value="findDue &amp;amp; update status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7E22CE;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ob_engine" target="inf_reminder_store">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1820" y="890" />
              <mxPoint x="1820" y="640" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Engine to Telecom Sink -->
        <mxCell id="e_engine_telecom" value="sendSMS()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ob_engine" target="ext_telecom">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1780" y="930" />
              <mxPoint x="1915" y="930" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diag-ch01-adapter-uml" name="2. CH01 Adapter UML">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE BLOCK -->
        <mxCell id="title_ad" value="&lt;div style=&quot;font-size:24px;font-weight:bold;color:#0F172A;&quot;&gt;CH01: Video Consultation Adapter Pattern — UML Class Diagram&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#475569;margin-top:4px;&quot;&gt;Source-Verified GoF Structural Pattern: Target Interface, Concrete Adapter, Adaptee (Local Demonstration Mock), Client &amp;amp; Factory&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="2200" height="70" as="geometry" />
        </mxCell>

        <!-- CLIENT BOX -->
        <mxCell id="uml_client" value="&lt;b&gt;Client: Appointment Orchestrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/actions/appointment.actions.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;+ createAppointment(appointment: CreateAppointmentParams): Promise&amp;lt;Appointment&amp;gt;&lt;br&gt;+ updateAppointment(params: UpdateAppointmentParams): Promise&amp;lt;Appointment&amp;gt;&lt;br&gt;+ VideoTokenRoute: POST /api/video/token(request: NextRequest)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="480" height="130" as="geometry" />
        </mxCell>

        <!-- FACTORY BOX -->
        <mxCell id="uml_factory" value="&lt;b&gt;VideoServiceFactory&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/video/VideoServiceFactory.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;+ static getVideoService(): IVideoConsultationService&lt;br&gt;+ static createService(): IVideoConsultationService&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="480" height="90" as="geometry" />
        </mxCell>

        <!-- TARGET INTERFACE BOX -->
        <mxCell id="uml_target" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;IVideoConsultationService&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/video/IVideoConsultationService.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;+ createRoom(request: VideoRoomRequest): Promise&amp;lt;VideoRoomDetails&amp;gt;&lt;br&gt;+ getRoomDetails(roomId: string): Promise&amp;lt;VideoRoomDetails | null&amp;gt;&lt;br&gt;+ generateParticipantAccess(roomId: string, participant: VideoParticipant): Promise&amp;lt;VideoSessionAccess&amp;gt;&lt;br&gt;+ getProviderName(): string&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="140" width="560" height="150" as="geometry" />
        </mxCell>

        <!-- CONCRETE ADAPTER BOX -->
        <mxCell id="uml_adapter" value="&lt;b&gt;LocalDemonstrationVideoAdapter&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/video/LocalDemonstrationVideoAdapter.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;- adaptee: LocalDemonstrationVideoProvider&lt;hr size=&quot;1&quot;&gt;+ constructor(adaptee?: LocalDemonstrationVideoProvider)&lt;br&gt;+ createRoom(request: VideoRoomRequest): Promise&amp;lt;VideoRoomDetails&amp;gt;&lt;br&gt;+ getRoomDetails(roomId: string): Promise&amp;lt;VideoRoomDetails | null&amp;gt;&lt;br&gt;+ generateParticipantAccess(roomId: string, participant: VideoParticipant): Promise&amp;lt;VideoSessionAccess&amp;gt;&lt;br&gt;+ getProviderName(): string&lt;br&gt;&lt;i style=&quot;color:#1E40AF;&quot;&gt;[Data Mapping]: Translates ISO Date to epoch, maps doctor-&amp;gt;clinician, patient-&amp;gt;client&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="380" width="560" height="210" as="geometry" />
        </mxCell>

        <!-- ADAPTEE BOX (Local Demo Mock) -->
        <mxCell id="uml_adaptee" value="&lt;b&gt;LocalDemonstrationVideoProvider&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/video/LocalDemonstrationVideoProvider.ts&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;[EXPLICIT LOCAL DEMONSTRATION MOCK]&lt;/b&gt;&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;- activeSessions: Map&amp;lt;string, ProprietarySessionResponse[&quot;data&quot;]&amp;gt;&lt;hr size=&quot;1&quot;&gt;+ initiateMeetingSession(payload: ProprietarySessionPayload): Promise&amp;lt;ProprietarySessionResponse&amp;gt;&lt;br&gt;+ querySession(sessionId: string): Promise&amp;lt;ProprietarySessionResponse[&quot;data&quot;] | null&amp;gt;&lt;br&gt;+ mintJoinToken(sessionId: string, proprietaryRole: string, clientTag: string): Promise&amp;lt;ProprietaryTokenResponse&amp;gt;&lt;br&gt;+ terminateSession(sessionId: string): Promise&amp;lt;boolean&amp;gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1320" y="380" width="580" height="210" as="geometry" />
        </mxCell>

        <!-- DATA STRUCTURES PANEL (DTOs) -->
        <mxCell id="uml_dtos_box" value="&lt;b&gt;Domain Data Transfer Models (Part2/code/lib/video/types.ts)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="1840" height="260" as="geometry" />
        </mxCell>

        <mxCell id="dto_room_req" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; VideoRoomRequest&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ appointmentId: string&lt;br&gt;+ doctorName: string&lt;br&gt;+ patientName: string&lt;br&gt;+ scheduledTime: Date&lt;br&gt;+ topic?: string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="710" width="260" height="170" as="geometry" />
        </mxCell>

        <mxCell id="dto_room_det" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; VideoRoomDetails&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ roomId: string&lt;br&gt;+ roomUrl: string&lt;br&gt;+ provider: string&lt;br&gt;+ createdAt: Date&lt;br&gt;+ scheduledTime: Date&lt;br&gt;+ doctorName: string&lt;br&gt;+ patientName: string&lt;br&gt;+ status: string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="710" width="270" height="170" as="geometry" />
        </mxCell>

        <mxCell id="dto_access" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; VideoSessionAccess&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ roomId: string&lt;br&gt;+ joinUrl: string&lt;br&gt;+ accessToken: string&lt;br&gt;+ expiresAt: Date&lt;br&gt;+ participant: VideoParticipant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="710" width="280" height="170" as="geometry" />
        </mxCell>

        <mxCell id="dto_payload" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; ProprietarySessionPayload&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ sessionTag: string&lt;br&gt;+ startTimestampEpoch: number&lt;br&gt;+ hostIdentifier: string&lt;br&gt;+ guestIdentifier: string&lt;br&gt;+ metadataPayload: object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="710" width="310" height="170" as="geometry" />
        </mxCell>

        <mxCell id="dto_response" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; ProprietarySessionResponse&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ statusCode: number&lt;br&gt;+ data: {&lt;br&gt;    sessionId: string,&lt;br&gt;    rawEndpointUrl: string,&lt;br&gt;    hostName: string,&lt;br&gt;    guestName: string&lt;br&gt;  }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="710" width="300" height="170" as="geometry" />
        </mxCell>


        <!-- UML CONNECTORS -->
        <!-- Client depends on Target -->
        <mxCell id="uml_e1" value="uses / calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.5;dashed=1;endArrow=open;" edge="1" parent="1" source="uml_client" target="uml_target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Client calls Factory -->
        <mxCell id="uml_e2" value="requests service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=1.2;dashed=1;endArrow=open;" edge="1" parent="1" source="uml_client" target="uml_factory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Factory instantiates Adapter -->
        <mxCell id="uml_e3" value="instantiates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.2;dashed=1;endArrow=open;" edge="1" parent="1" source="uml_factory" target="uml_adapter">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="480" />
              <mxPoint x="650" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Adapter realizes Target (implements) -->
        <mxCell id="uml_e4" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=2;dashed=1;endArrow=block;endFill=0;" edge="1" parent="1" source="uml_adapter" target="uml_target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Adapter has-a Adaptee (Composition / Association) -->
        <mxCell id="uml_e5" value="- adaptee&#xa;1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=2;endArrow=open;" edge="1" parent="1" source="uml_adapter" target="uml_adaptee">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diag-ch02-strategy-uml" name="3. CH02 Strategy UML">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE BLOCK -->
        <mxCell id="title_st" value="&lt;div style=&quot;font-size:24px;font-weight:bold;color:#0F172A;&quot;&gt;CH02: Flexible Doctor Availability Strategy Pattern — UML Class Diagram&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#475569;margin-top:4px;&quot;&gt;Source-Verified GoF Behavioral Pattern: Strategy Interface, 3 Concrete Strategies, Context, Dynamic Selection &amp;amp; Client Action&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="2200" height="70" as="geometry" />
        </mxCell>

        <!-- CLIENT BOX -->
        <mxCell id="st_uml_client" value="&lt;b&gt;Client: Appointment Server Action&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/actions/appointment.actions.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;+ createAppointment(appointment: CreateAppointmentParams): Promise&amp;lt;Appointment&amp;gt;&lt;br&gt;&lt;i style=&quot;color:#047857;&quot;&gt;Queries doctor config -&amp;gt; Context.resolveStrategy() -&amp;gt; context.validateSlot()&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="500" height="110" as="geometry" />
        </mxCell>

        <!-- CONTEXT BOX -->
        <mxCell id="st_uml_context" value="&lt;b&gt;DoctorAvailabilityContext&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/availability/DoctorAvailabilityContext.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;- strategy: IAvailabilityStrategy&lt;hr size=&quot;1&quot;&gt;+ constructor(initialStrategy?: IAvailabilityStrategy)&lt;br&gt;+ setStrategy(strategy: IAvailabilityStrategy): void&lt;br&gt;+ getStrategy(): IAvailabilityStrategy&lt;br&gt;+ static resolveStrategy(config: DoctorAvailabilityConfig): IAvailabilityStrategy&lt;br&gt;+ validateSlot(request: SlotValidationRequest, config: DoctorAvailabilityConfig, existingBookings: ExistingBooking[]): SlotValidationResult&lt;br&gt;+ generateAvailableSlots(date: Date, config: DoctorAvailabilityConfig, existingBookings: ExistingBooking[]): Date[]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="600" height="200" as="geometry" />
        </mxCell>

        <!-- STRATEGY INTERFACE BOX -->
        <mxCell id="st_uml_interface" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;IAvailabilityStrategy&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/availability/IAvailabilityStrategy.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;+ validateSlot(request: SlotValidationRequest, config: DoctorAvailabilityConfig, existingBookings: ExistingBooking[]): SlotValidationResult&lt;br&gt;+ generateAvailableSlots(date: Date, config: DoctorAvailabilityConfig, existingBookings: ExistingBooking[]): Date[]&lt;br&gt;+ getStrategyType(): StrategyType&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=2;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="320" width="620" height="150" as="geometry" />
        </mxCell>

        <!-- CONCRETE STRATEGY 1 -->
        <mxCell id="st_uml_strat1" value="&lt;b&gt;StandardBusinessHoursStrategy&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/availability/StandardBusinessHoursStrategy.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;- startHour: number = 9&lt;br&gt;- endHour: number = 17&lt;br&gt;- lunchStart: number = 12&lt;br&gt;- lunchEnd: number = 13&lt;hr size=&quot;1&quot;&gt;+ validateSlot(...): SlotValidationResult&lt;br&gt;+ generateAvailableSlots(...): Date[]&lt;br&gt;+ getStrategyType(): &quot;STANDARD_BUSINESS_HOURS&quot;&lt;br&gt;&lt;i style=&quot;color:#047857;&quot;&gt;• Mon-Fri 09:00-17:00 outpatient schedule&lt;br&gt;• Rejects weekends &amp;amp; lunch blackout&lt;br&gt;• Verifies booking overlap conflicts&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="580" width="380" height="220" as="geometry" />
        </mxCell>

        <!-- CONCRETE STRATEGY 2 -->
        <mxCell id="st_uml_strat2" value="&lt;b&gt;ShiftBasedAvailabilityStrategy&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/availability/ShiftBasedAvailabilityStrategy.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;- defaultShifts: DoctorShift[]&lt;hr size=&quot;1&quot;&gt;+ validateSlot(...): SlotValidationResult&lt;br&gt;+ generateAvailableSlots(...): Date[]&lt;br&gt;+ getStrategyType(): &quot;SHIFT_BASED&quot;&lt;br&gt;&lt;i style=&quot;color:#047857;&quot;&gt;• Rotating shift rosters per physician&lt;br&gt;• Morning (07-15), Evening (15-23), Night&lt;br&gt;• Rejects off-duty days &amp;amp; hours outside shift&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1010" y="580" width="380" height="220" as="geometry" />
        </mxCell>

        <!-- CONCRETE STRATEGY 3 -->
        <mxCell id="st_uml_strat3" value="&lt;b&gt;EmergencyOnCallAvailabilityStrategy&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/availability/EmergencyOnCallAvailabilityStrategy.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;- defaultBufferMinutes: number = 15&lt;hr size=&quot;1&quot;&gt;+ validateSlot(...): SlotValidationResult&lt;br&gt;+ generateAvailableSlots(...): Date[]&lt;br&gt;+ getStrategyType(): &quot;EMERGENCY_ON_CALL&quot;&lt;br&gt;&lt;i style=&quot;color:#047857;&quot;&gt;• 24/7 continuous triage availability&lt;br&gt;• Permits late-night &amp;amp; weekend emergencies&lt;br&gt;• Enforces mandatory 15-min recovery buffer gap&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1420" y="580" width="380" height="220" as="geometry" />
        </mxCell>

        <!-- DATA STRUCTURES PANEL -->
        <mxCell id="st_uml_types_box" value="&lt;b&gt;Strategy Data Types &amp;amp; Roster Configurations (Part2/code/lib/availability/types.ts &amp;amp; constants/index.ts)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="850" width="1740" height="240" as="geometry" />
        </mxCell>

        <mxCell id="st_dto_req" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; SlotValidationRequest&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ doctorName: string&lt;br&gt;+ requestedTime: Date&lt;br&gt;+ durationMinutes: number&lt;br&gt;+ isEmergency?: boolean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="900" width="320" height="150" as="geometry" />
        </mxCell>

        <mxCell id="st_dto_res" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; SlotValidationResult&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ isValid: boolean&lt;br&gt;+ reason?: string&lt;br&gt;+ conflictingBooking?: ExistingBooking&lt;br&gt;+ evaluatedStrategy: StrategyType" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="900" width="340" height="150" as="geometry" />
        </mxCell>

        <mxCell id="st_dto_cfg" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; DoctorAvailabilityConfig&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ doctorName: string&lt;br&gt;+ strategyType: StrategyType&lt;br&gt;+ assignedShifts?: DoctorShift[]&lt;br&gt;+ emergencyBufferMinutes?: number&lt;br&gt;+ slotDurationMinutes?: number" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="810" y="900" width="350" height="150" as="geometry" />
        </mxCell>

        <mxCell id="st_dto_notice" value="&lt;b&gt;CONCURRENCY LIMITATION NOTICE (TOCTOU)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;font-size:10px;line-height:1.4;&quot;&gt;The Strategy pattern validates slot legality at the application layer.&lt;br&gt;In high-concurrency environments, two concurrent requests for the exact same slot may both evaluate as valid in memory before the first record commits to the database (Time-of-Check to Time-of-Use race condition).&lt;br&gt;Production remediation requires database-level unique constraints (e.g. compound index on [doctorId, scheduleTimestamp]) or optimistic version matching.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1190" y="900" width="580" height="150" as="geometry" />
        </mxCell>

        <!-- UML CONNECTORS -->
        <!-- Client uses Context -->
        <mxCell id="st_e1" value="instantiates / calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;endArrow=open;" edge="1" parent="1" source="st_uml_client" target="st_uml_context">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Context has-a Strategy (Aggregation / Composition) -->
        <mxCell id="st_e2" value="- strategy&#xa;1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;endArrow=open;" edge="1" parent="1" source="st_uml_context" target="st_uml_interface">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

