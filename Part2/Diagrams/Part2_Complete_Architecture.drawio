        <!-- TITLE BLOCK -->
        <mxCell id="title_ob" value="&lt;div style=&quot;font-size:24px;font-weight:bold;color:#0F172A;&quot;&gt;CH03: Automated Appointment Reminders Observer Pattern &amp;amp; Event Flow&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#475569;margin-top:4px;&quot;&gt;Source-Verified GoF Behavioral Pattern: DomainEventBus (Subject), Subscribers, Persistent Store, Engine &amp;amp; Chronological Flow&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
