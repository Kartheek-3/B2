        </mxCell>

        <mxCell id="ad_factory" value="&lt;b&gt;VideoServiceFactory&lt;/b&gt;&lt;br&gt;Resolves active adapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.2;" vertex="1" parent="1">
