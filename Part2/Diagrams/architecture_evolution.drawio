        <mxCell id="e_sub_obs2" value="notify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9333EA;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ob_subject" target="ob_obs2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Observers to Store -->
