        </mxCell>

        <mxCell id="st_context" value="&lt;b&gt;&amp;lt;&amp;lt;Context&amp;gt;&amp;gt;&lt;br&gt;DoctorAvailabilityContext&lt;/b&gt;&lt;br&gt;Holds IAvailabilityStrategy;&lt;br&gt;Swaps strategies dynamically;&lt;br&gt;Server validation &amp;amp; conflict check." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1250" y="540" width="210" height="90" as="geometry" />
        </mxCell>

        <mxCell id="st_interface" value="&lt;b&gt;&amp;lt;&amp;lt;Strategy Interface&amp;gt;&amp;gt;&lt;br&gt;IAvailabilityStrategy&lt;/b&gt;&lt;br&gt;validateSlot()&lt;br&gt;generateAvailableSlots()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1510" y="540" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="st_strat1" value="&lt;b&gt;StandardBusinessHoursStrategy&lt;/b&gt;&lt;br&gt;Mon-Fri 09:00-17:00, lunch break" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1250" y="660" width="230" height="50" as="geometry" />
        </mxCell>

        <mxCell id="st_strat2" value="&lt;b&gt;ShiftBasedAvailabilityStrategy&lt;/b&gt;&lt;br&gt;Assigned morning/evening/night shifts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1500" y="660" width="230" height="50" as="geometry" />
        </mxCell>

        <mxCell id="st_strat3" value="&lt;b&gt;EmergencyOnCallAvailabilityStrategy&lt;/b&gt;&lt;br&gt;24/7 triage + mandatory 15-min recovery buffer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1250" y="730" width="480" height="50" as="geometry" />
        </mxCell>


        <!-- LAYER 5: CH03 OBSERVER PATTERN & REMINDER ENGINE -->
        <mxCell id="p_observer" value="&lt;div style=&quot;font-size:16px;font-weight:bold;color:#581C87;&quot;&gt;CH03: OBSERVER PATTERN &amp;amp; AUTOMATED REMINDER ENGINE&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;verticalAlign=top;spacingTop=12;align=left;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="1800" y="100" width="540" height="760" as="geometry" />
        </mxCell>

        <mxCell id="ob_subject" value="&lt;b&gt;&amp;lt;&amp;lt;Subject / Event Bus&amp;gt;&amp;gt;&lt;br&gt;DomainEventBus&lt;/b&gt;&lt;br&gt;subscribe(), unsubscribe(), publish()&lt;br&gt;Broadcasts: APPOINTMENT_SCHEDULED,&lt;br&gt;APPOINTMENT_CANCELLED, APPOINTMENT_RESCHEDULED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1830" y="150" width="480" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ob_obs1" value="&lt;b&gt;&amp;lt;&amp;lt;Observer 1&amp;gt;&amp;gt;&lt;br&gt;ReminderSchedulerObserver&lt;/b&gt;&lt;br&gt;Calculates T-24h &amp;amp; T-2h windows;&lt;br&gt;generates idempotent reminder tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1830" y="270" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ob_obs2" value="&lt;b&gt;&amp;lt;&amp;lt;Observer 2&amp;gt;&amp;gt;&lt;br&gt;ReminderCancellationObserver&lt;/b&gt;&lt;br&gt;Revokes &amp;amp; invalidates pending reminders on cancellation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="2080" y="270" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ob_obs3" value="&lt;b&gt;&amp;lt;&amp;lt;Observer 3&amp;gt;&amp;gt;&lt;br&gt;AuditLogObserver&lt;/b&gt;&lt;br&gt;Chronological audit logging of all lifecycle events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1830" y="370" width="480" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ob_store" value="&lt;b&gt;JsonFileReminderStore (Persistent Store)&lt;/b&gt;&lt;br&gt;Disk storage (reminders_store.json) with idempotency keys&lt;br&gt;Prevents duplicate creation &amp;amp; manages state transitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1830" y="450" width="480" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ob_engine" value="&lt;b&gt;ReminderProcessingEngine&lt;/b&gt;&lt;br&gt;Evaluates due tasks (triggerAt &amp;lt;= T_now);&lt;br&gt;Transitions: PENDING -&amp;gt; PROCESSING -&amp;gt; SENT;&lt;br&gt;Retry policy with backoff; Zero duplicate delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1830" y="560" width="480" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ob_notifier" value="&lt;b&gt;Notification Channels&lt;/b&gt;&lt;br&gt;Appwrite Messaging / SMS Gateway &amp;amp; Local Dispatcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="1830" y="680" width="480" height="60" as="geometry" />
        </mxCell>


