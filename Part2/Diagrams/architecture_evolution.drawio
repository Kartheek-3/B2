        </mxCell>

        <!-- Engine to Store -->
        <mxCell id="e_eng_store" value="query &amp;amp; update status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F59E0B;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="ob_engine" target="ob_store">
