        <mxCell id="st_e5" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;dashed=1;endArrow=block;endFill=0;" edge="1" parent="1" source="st_uml_strat3" target="st_uml_interface">
          <mxGeometry relative="1" as="geometry">
