  <diagram id="diag-ch01-adapter-uml" name="2. CH01 Adapter UML">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE BLOCK -->
        <mxCell id="title_ad" value="&lt;div style=&quot;font-size:24px;font-weight:bold;color:#0F172A;&quot;&gt;CH01: Video Consultation Adapter Pattern — UML Class Diagram&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#475569;margin-top:4px;&quot;&gt;Source-Verified GoF Structural Pattern: Target Interface, Concrete Adapter, Adaptee (Local Demonstration Mock), Client &amp;amp; Factory&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="2200" height="70" as="geometry" />
        </mxCell>

        <!-- CLIENT BOX -->
        <mxCell id="uml_client" value="&lt;b&gt;Client: Appointment Orchestrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/actions/appointment.actions.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;+ createAppointment(appointment: CreateAppointmentParams): Promise&amp;lt;Appointment&amp;gt;&lt;br&gt;+ updateAppointment(params: UpdateAppointmentParams): Promise&amp;lt;Appointment&amp;gt;&lt;br&gt;+ VideoTokenRoute: POST /api/video/token(request: NextRequest)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="480" height="130" as="geometry" />
        </mxCell>

        <!-- FACTORY BOX -->
        <mxCell id="uml_factory" value="&lt;b&gt;VideoServiceFactory&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/video/VideoServiceFactory.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;+ static getVideoService(): IVideoConsultationService&lt;br&gt;+ static createService(): IVideoConsultationService&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="480" height="90" as="geometry" />
        </mxCell>

        <!-- TARGET INTERFACE BOX -->
        <mxCell id="uml_target" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;IVideoConsultationService&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/video/IVideoConsultationService.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;+ createRoom(request: VideoRoomRequest): Promise&amp;lt;VideoRoomDetails&amp;gt;&lt;br&gt;+ getRoomDetails(roomId: string): Promise&amp;lt;VideoRoomDetails | null&amp;gt;&lt;br&gt;+ generateParticipantAccess(roomId: string, participant: VideoParticipant): Promise&amp;lt;VideoSessionAccess&amp;gt;&lt;br&gt;+ getProviderName(): string&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="140" width="560" height="150" as="geometry" />
        </mxCell>

        <!-- CONCRETE ADAPTER BOX -->
        <mxCell id="uml_adapter" value="&lt;b&gt;LocalDemonstrationVideoAdapter&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/video/LocalDemonstrationVideoAdapter.ts&lt;/i&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;- adaptee: LocalDemonstrationVideoProvider&lt;hr size=&quot;1&quot;&gt;+ constructor(adaptee?: LocalDemonstrationVideoProvider)&lt;br&gt;+ createRoom(request: VideoRoomRequest): Promise&amp;lt;VideoRoomDetails&amp;gt;&lt;br&gt;+ getRoomDetails(roomId: string): Promise&amp;lt;VideoRoomDetails | null&amp;gt;&lt;br&gt;+ generateParticipantAccess(roomId: string, participant: VideoParticipant): Promise&amp;lt;VideoSessionAccess&amp;gt;&lt;br&gt;+ getProviderName(): string&lt;br&gt;&lt;i style=&quot;color:#1E40AF;&quot;&gt;[Data Mapping]: Translates ISO Date to epoch, maps doctor-&amp;gt;clinician, patient-&amp;gt;client&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="380" width="560" height="210" as="geometry" />
        </mxCell>

        <!-- ADAPTEE BOX (Local Demo Mock) -->
        <mxCell id="uml_adaptee" value="&lt;b&gt;LocalDemonstrationVideoProvider&lt;/b&gt;&lt;br&gt;&lt;i&gt;Part2/code/lib/video/LocalDemonstrationVideoProvider.ts&lt;/i&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;b&gt;[EXPLICIT LOCAL DEMONSTRATION MOCK]&lt;/b&gt;&lt;/font&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;&quot;&gt;- activeSessions: Map&amp;lt;string, ProprietarySessionResponse[&quot;data&quot;]&amp;gt;&lt;hr size=&quot;1&quot;&gt;+ initiateMeetingSession(payload: ProprietarySessionPayload): Promise&amp;lt;ProprietarySessionResponse&amp;gt;&lt;br&gt;+ querySession(sessionId: string): Promise&amp;lt;ProprietarySessionResponse[&quot;data&quot;] | null&amp;gt;&lt;br&gt;+ mintJoinToken(sessionId: string, proprietaryRole: string, clientTag: string): Promise&amp;lt;ProprietaryTokenResponse&amp;gt;&lt;br&gt;+ terminateSession(sessionId: string): Promise&amp;lt;boolean&amp;gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1320" y="380" width="580" height="210" as="geometry" />
        </mxCell>

        <!-- DATA STRUCTURES PANEL (DTOs) -->
        <mxCell id="uml_dtos_box" value="&lt;b&gt;Domain Data Transfer Models (Part2/code/lib/video/types.ts)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1.5;verticalAlign=top;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="1840" height="260" as="geometry" />
        </mxCell>

        <mxCell id="dto_room_req" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; VideoRoomRequest&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ appointmentId: string&lt;br&gt;+ doctorName: string&lt;br&gt;+ patientName: string&lt;br&gt;+ scheduledTime: Date&lt;br&gt;+ topic?: string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="710" width="260" height="170" as="geometry" />
        </mxCell>

        <mxCell id="dto_room_det" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; VideoRoomDetails&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ roomId: string&lt;br&gt;+ roomUrl: string&lt;br&gt;+ provider: string&lt;br&gt;+ createdAt: Date&lt;br&gt;+ scheduledTime: Date&lt;br&gt;+ doctorName: string&lt;br&gt;+ patientName: string&lt;br&gt;+ status: string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="710" width="270" height="170" as="geometry" />
        </mxCell>

        <mxCell id="dto_access" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; VideoSessionAccess&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ roomId: string&lt;br&gt;+ joinUrl: string&lt;br&gt;+ accessToken: string&lt;br&gt;+ expiresAt: Date&lt;br&gt;+ participant: VideoParticipant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="710" width="280" height="170" as="geometry" />
        </mxCell>

        <mxCell id="dto_payload" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; ProprietarySessionPayload&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ sessionTag: string&lt;br&gt;+ startTimestampEpoch: number&lt;br&gt;+ hostIdentifier: string&lt;br&gt;+ guestIdentifier: string&lt;br&gt;+ metadataPayload: object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="990" y="710" width="310" height="170" as="geometry" />
        </mxCell>

        <mxCell id="dto_response" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt; ProprietarySessionResponse&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;+ statusCode: number&lt;br&gt;+ data: {&lt;br&gt;    sessionId: string,&lt;br&gt;    rawEndpointUrl: string,&lt;br&gt;    hostName: string,&lt;br&gt;    guestName: string&lt;br&gt;  }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;verticalAlign=top;align=left;spacing=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="710" width="300" height="170" as="geometry" />
        </mxCell>


        <!-- UML CONNECTORS -->
        <!-- Client depends on Target -->
        <mxCell id="uml_e1" value="uses / calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.5;dashed=1;endArrow=open;" edge="1" parent="1" source="uml_client" target="uml_target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Client calls Factory -->
        <mxCell id="uml_e2" value="requests service" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#475569;strokeWidth=1.2;dashed=1;endArrow=open;" edge="1" parent="1" source="uml_client" target="uml_factory">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Factory instantiates Adapter -->
        <mxCell id="uml_e3" value="instantiates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=1.2;dashed=1;endArrow=open;" edge="1" parent="1" source="uml_factory" target="uml_adapter">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="480" />
              <mxPoint x="650" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Adapter realizes Target (implements) -->
        <mxCell id="uml_e4" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=2;dashed=1;endArrow=block;endFill=0;" edge="1" parent="1" source="uml_adapter" target="uml_target">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Adapter has-a Adaptee (Composition / Association) -->
        <mxCell id="uml_e5" value="- adaptee&#xa;1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;strokeWidth=2;endArrow=open;" edge="1" parent="1" source="uml_adapter" target="uml_adaptee">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
